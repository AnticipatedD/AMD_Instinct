# ==============================================================================
# AMD INSTINCT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: Never commit actual operational credentials or real production secrets 
# to the repository history. Copy this template to '.env' and populate values.

# The destination engine URI endpoint mapping to the running vLLM framework deployment node
ROCM_ENGINE_URL=http://localhost:8000/v1

# Authentication credentials key token layer required by the OpenAI interface pipeline
ROCM_API_KEY=your_rocm_api_key_here

# Access credential token identifier required to fetch restricted weights paths from Hugging Face
HUGGING_FACE_HUB_TOKEN=your_real_huggingface_token_here
